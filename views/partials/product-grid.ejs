<div class="product-grid">
<% for(const product of products){ %><article class="product-card">
  <div class="product-image-wrap"><a href="/products/<%= product.id %>"><img class="product-image" src="<%= product.image_path %>" alt="<%= product.title %>" loading="lazy" width="600" height="450"></a><span class="product-tag"><%= product.category %></span>
    <form class="save-form" action="/products/<%= product.id %>/save" method="post" data-save-form><%- include('csrf') %><input type="hidden" name="next" value="<%= currentPath==='/'?'/':currentPath %>"><button class="save-button <%= product.saved?'is-saved':'' %>" type="submit" aria-label="<%= product.saved?'Unsave':'Save' %> <%= product.title %>" aria-pressed="<%= product.saved?'true':'false' %>"><svg aria-hidden="true"><use href="#i-heart"></use></svg></button></form>
    <% if(product.badges){ %><div class="badge-row badge-row-card"><% for(const badge of product.badges.split(',')){ %><span class="verification-badge badge-<%= badge.toLowerCase() %>"><svg aria-hidden="true"><use href="#i-shield"></use></svg>Verified <%= badge %></span><% } %></div><% } %>
  </div><div class="product-body"><div class="product-seller"><span class="seller-avatar"><%= initials(product.seller_name) %></span><span><%= product.seller_name %></span><span class="seller-rating"><%= Number(product.seller_rating)>0?'★ '+Number(product.seller_rating).toFixed(1):'New seller' %></span></div>
  <h3 class="product-title"><a href="/products/<%= product.id %>"><%= product.title %></a></h3><p class="item-rating"><%= product.review_count?'★ '+Number(product.rating).toFixed(1)+' · '+product.review_count+' item reviews':'No item reviews yet' %></p><p class="product-meta"><svg aria-hidden="true"><use href="#i-pin"></use></svg><span><%= product.pickup_location %></span></p><div class="product-bottom"><span class="product-price"><%= money(product.price) %></span><span class="product-condition"><%= product.stock?'In stock':'Sold out' %></span></div><span class="identity-type-label"><%= product.business_id?'Campus business':'Individual seller' %><%= product.is_sample?' · Sample listing':'' %></span></div>
</article><% } %>
</div>
<% if(!products.length){ %><div class="empty-state"><svg aria-hidden="true"><use href="#i-bag"></use></svg><h2>A little space for your next find</h2><p>Try another filter, or be the first to list something here.</p><a class="primary-button" href="/seller/products/new">List something ↗</a></div><% } %>
