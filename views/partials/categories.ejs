<section class="categories" aria-label="Browse by category"><a class="category-card <%= !query.category?'active':'' %>" href="/products"><span class="category-art"><svg aria-hidden="true"><use href="/assets/lowpoly-icons.svg#all"></use></svg></span><span>All finds<small>A bit of everything</small></span></a>
<% for(const category of categories){ %><a class="category-card <%= String(query.category)===String(category.id)?'active':'' %>" href="/products?category=<%= category.id %>"><span class="category-art"><svg aria-hidden="true"><use href="/assets/lowpoly-icons.svg#<%= category.icon %>"></use></svg></span><span><%= category.name==='Food'?'Food & drinks':category.name %><small><%= category.description %></small></span></a><% } %></section>
