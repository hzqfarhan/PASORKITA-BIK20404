<% if(!orders.length){ %><div class="empty-state"><h2><%= sellerView?'Your next customer is closer than you think':'Your next good find is waiting' %></h2><p><%= sellerView?'Incoming orders will appear here.':'Place a pickup order to start your campus connection.' %></p><a class="secondary-button" href="/products">Explore campus finds ↗</a></div><% } %>
<div class="orders-list"><% for(const order of orders){ %><article class="surface order-entry"><header><div><span class="section-overline">ORDER #<%= order.id %></span><h3><%= order.product_title %></h3><p><%= sellerView?'Buyer':'Seller' %>: <%= order.counterpart %></p></div><span class="order-status status-<%= order.status %>"><%= order.status==='ready'?'Ready for pickup':order.status %></span></header><p><%= order.quantity %> × product · <strong><%= money(order.total) %></strong></p><p class="pickup-note"><%= order.pickup_details %></p><a class="text-button" href="/products/<%= order.product_id %>">View product ↗</a><div class="action-row"><% const nextStatus=({pending:'accepted',accepted:'ready',ready:'completed'})[order.status]; if(sellerView && nextStatus){ %><form action="/orders/<%= order.id %>/status" method="post"><%- include('csrf') %><input type="hidden" name="view" value="seller"><input type="hidden" name="status" value="<%= nextStatus %>"><button type="submit" class="primary-button"><%= ({accepted:'Accept order',ready:'Ready for pickup',completed:'Confirm completed pickup'})[nextStatus] %></button></form><% } %><% if(sellerView?!['completed','cancelled'].includes(order.status):order.status==='pending'){ %><form action="/orders/<%= order.id %>/status" method="post" data-confirm="Cancel this pickup order? Reserved stock will be returned."><%- include('csrf') %><input type="hidden" name="status" value="cancelled"><input type="hidden" name="view" value="<%= sellerView?'seller':'buyer' %>"><button class="text-button danger" type="submit">Cancel order</button></form><% } %></div>
<% if(order.status==='completed'){for(const kind of (sellerView?['buyer']:['item','seller'])){if(!sellerView && order.reviewed?.split(',').includes(kind))continue; %><details class="review-editor"><summary>Leave a <%= kind %> review</summary><form action="/orders/<%= order.id %>/reviews" method="post"><%- include('csrf') %><input type="hidden" name="kind" value="<%= kind %>"><label>Rating<select name="rating"><% for(const rating of [5,4,3,2,1]){ %><option value="<%= rating %>"><%= rating %> out of 5</option><% } %></select></label><label>Your <%= kind %> review<textarea name="comment" minlength="8" maxlength="600" rows="3" required></textarea></label><button type="submit" class="secondary-button">Share my review</button></form></details><% }} %></article><% } %></div>
