<div class="page-heading"><div class="section-overline">COMMUNITY ADMINISTRATION</div><h1>Looking after our campus</h1><p>A little care keeps the marketplace useful for everyone.</p></div>
<section class="surface"><h2>Categories</h2><form class="inline-form" action="/admin/categories" method="post"><%- include('../partials/csrf') %><label>Name<input name="name" minlength="2" maxlength="40" required></label><label>Description<input name="description" minlength="2" maxlength="160" required></label><button class="primary-button" type="submit">Add category</button></form><% for(const category of categories){ %><form class="inline-form category-editor" action="/admin/categories/<%= category.id %>" method="post"><%- include('../partials/csrf') %><label>Category name<input name="name" value="<%= category.name %>" maxlength="40" required></label><label>Description<input name="description" value="<%= category.description %>" maxlength="160" required></label><button name="action" value="update" type="submit" class="secondary-button">Save</button><button name="action" value="delete" type="submit" class="text-button danger">Delete unused</button></form><% } %></section>
<section class="surface admin-section"><h2>Listing moderation</h2><div class="table-scroll"><table><thead><tr><th scope="col">Product</th><th scope="col">Seller</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody><% for(const product of products){ %><tr><td><%= product.title %></td><td><%= product.seller_name %></td><td><%= product.status %></td><td><form action="/admin/products/<%= product.id %>" method="post"><%- include('../partials/csrf') %><button name="status" value="<%= product.status==='removed'?'active':'removed' %>" class="text-button" type="submit"><%= product.status==='removed'?'Restore':'Remove' %></button></form></td></tr><% } %></tbody></table></div></section>
<section class="surface admin-section"><h2>Business registration reviews</h2><p>Check registration evidence independently before approving an SSM or PTU badge. A campus email does not confer either badge.</p><% if(!verifications.length){ %><p class="quiet-note">No pending requests.</p><% } %><% for(const request of verifications){ %><article class="verification-entry"><h3><%= request.name %> · <%= request.type %></h3><p>Reference: <%= request.reference %></p><form action="/admin/verifications/<%= request.id %>" method="post" class="action-row"><%- include('../partials/csrf') %><button class="secondary-button" name="status" value="approved" type="submit">Approve reviewed evidence</button><button class="text-button danger" name="status" value="rejected" type="submit">Reject</button></form></article><% } %></section>
<section class="surface admin-section"><h2>Review moderation</h2><% if(!reviews.length){ %><p class="quiet-note">No reviews yet.</p><% } %><% for(const review of reviews){ %><article class="review-entry"><strong><%= review.name %> · <%= review.kind %> · <%= review.rating %>/5</strong><p><%= review.comment %></p><form action="/admin/reviews/<%= review.id %>" method="post"><%- include('../partials/csrf') %><button class="text-button" name="hidden" value="<%= review.hidden?'false':'true' %>" type="submit"><%= review.hidden?'Restore review':'Hide review' %></button></form></article><% } %></section>
