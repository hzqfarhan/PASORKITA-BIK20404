<div class="page-heading heading-with-action"><div><div class="section-overline">YOUR CORNER OF THE MARKETPLACE</div><h1>Your seller studio</h1><p>A place for what you make, and what comes next.</p></div><a class="primary-button" href="/seller/products/new">List something ↗</a></div><section><h2>Your listings</h2><div class="table-scroll surface"><table><thead><tr><th scope="col">Product</th><th scope="col">Price</th><th scope="col">Stock</th><th scope="col">Status</th><th scope="col">Manage</th></tr></thead><tbody><% for(const product of products){ %><tr><td><%= product.title %><small><%= product.seller_name %></small></td><td><%= money(product.price) %></td><td><%= product.stock %></td><td><%= product.status %></td><td><% if(product.status!=='removed'){ %><a href="/seller/products/<%= product.id %>/edit">Edit ↗</a><form action="/seller/products/<%= product.id %>/delete" method="post" data-confirm="Remove this listing from the marketplace? Existing order history will stay available."><%- include('../partials/csrf') %><button type="submit" class="text-button danger">Remove</button></form><% }else{ %>Removed by admin<% } %></td></tr><% } %><% if(!products.length){ %><tr><td colspan="5">Your next chapter starts with your first listing.</td></tr><% } %></tbody></table></div></section><section class="incoming-orders"><div class="section-heading"><div><div class="section-overline">GOOD THINGS GET AROUND</div><h2>Incoming pickup orders</h2><p>Accept, prepare and complete your campus exchanges.</p></div></div><%- include('../partials/orders',{sellerView:true}) %></section>
