<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/products">Marketplace</a><span>/</span><span><%= product.category %></span></nav>
<section class="product-detail-layout"><div class="detail-image-surface"><img class="detail-image" src="<%= product.image_path %>" alt="<%= product.title %>"><% if(product.is_sample){ %><span class="sample-disclosure">Sample catalogue listing</span><% } %></div><div class="detail-information"><div class="section-overline"><%= product.category %> · <%= product.campus %></div><h1><%= product.title %></h1><p class="large-price"><%= money(product.price) %></p><p class="item-rating"><%= product.review_count?'★ '+Number(product.rating).toFixed(1)+' from '+product.review_count+' item reviews':'Be the first to review this find' %></p><p class="description"><%= product.description %></p><dl class="product-facts"><div><dt>Condition</dt><dd><%= product.item_condition %></dd></div><div><dt>Pickup</dt><dd><%= product.pickup_location %></dd></div><div><dt>Available</dt><dd><%= product.stock %> remaining</dd></div></dl><div class="detail-seller"><span class="seller-avatar"><%= initials(product.seller_name) %></span><div><strong><%= product.seller_name %></strong><p><%= Number(product.seller_rating)>0?'★ '+Number(product.seller_rating).toFixed(1)+' seller reputation':'New campus seller' %></p></div><% if(product.badges){ %><span class="verification-badge"><%= product.badges.split(',').join(' + ') %> approved</span><% } %></div>
<div class="action-row"><% if(user?.id===product.seller_id){ %><a class="primary-button" href="/seller/products/<%= product.id %>/edit">Edit your listing ↗</a><% }else{ %><% if(product.stock){ %><a class="primary-button" href="/checkout/<%= product.id %>">Make it yours ↗</a><% }else{ %><span class="sold-out">Currently sold out</span><% } %><a class="secondary-button" href="/messages?product=<%= product.id %>&with=<%= product.seller_id %>">Message seller</a><% } %><form action="/products/<%= product.id %>/save" method="post" data-save-form><%- include('../partials/csrf') %><input type="hidden" name="next" value="/products/<%= product.id %>"><button type="submit" class="secondary-button" aria-pressed="<%= product.saved %>"><%= product.saved?'Saved to your finds':'Save for later' %></button></form></div><p class="quiet-note">Campus pickup. Payment on pickup. Check the item before completing your exchange.</p></div></section>
<section class="reviews-section"><div class="section-heading"><div><div class="section-overline">A LITTLE TRUST GOES A LONG WAY</div><h2>From your campus community</h2><p>Item feedback and profile reputation stay separate. Every review follows a completed order.</p></div></div><% if(!reviews.length){ %><p class="quiet-note">No reviews yet. Your next completed exchange could start the conversation.</p><% } %><div class="review-list"><% for(const review of reviews){ %><article class="review-entry surface"><div><strong><%= review.name %></strong><span><%= review.kind==='item'?'Item review':review.kind==='seller'?'Seller profile review':'Buyer profile review' %> · <%= review.rating %>/5</span></div><p><%= review.comment %></p></article><% } %></div></section>
