<div class="page-heading"><div class="section-overline">A LITTLE MORE YOU</div><h1>Your corner of campus</h1><p>One account. A place for every side of you.</p></div><div class="account-columns"><section class="surface"><h2>Your campus profile</h2><form action="/account" method="post"><%- include('../partials/csrf') %><label>Your name<input name="name" value="<%= user.name %>" minlength="2" maxlength="80" required></label><label>University email<input type="email" value="<%= user.email %>" readonly></label><label>Campus<select name="campus"><% for(const campus of ['Parit Raja','Pagoh']){ %><option <%= campus===user.campus?'selected':'' %>><%= campus %></option><% } %></select></label><label>Campus card colour<select name="card_color"><% for(const color of ['burgundy','forest','navy']){ %><option value="<%= color %>" <%= color===user.card_color?'selected':'' %>><%= color[0].toUpperCase()+color.slice(1) %></option><% } %></select></label><button type="submit" class="primary-button">Save my profile</button></form><p class="quiet-note"><%= user.email_verified?'Email ownership verified.':'University email ownership has not been verified.' %></p><div class="reputation-summary"><% for(const r of reputation){ %><span><strong>★ <%= Number(r.average).toFixed(1) %></strong> as a <%= r.kind %> · <%= r.count %> reviews</span><% } %></div></section><section class="profile-preview"><%- include('../partials/campus-card',{cardUser:user}) %></section></div>
<section id="businesses" class="businesses-section"><div class="section-heading"><div><div class="section-overline">YOUR NEXT CHAPTER</div><h2>Your campus businesses</h2><p>Each business belongs to your personal account. Registration badges receive separate reviews.</p></div></div><div class="businesses-grid"><% for(const business of businesses){ %><article class="surface"><h3><%= business.name %></h3><p class="quiet-note"><%= business.verifications || 'No registration references submitted' %></p><form action="/account/businesses/<%= business.id %>/verification" method="post"><%- include('../partials/csrf') %><label>Registration type<select name="type"><option>SSM</option><option>PTU</option></select></label><label>Registration reference<input name="reference" minlength="3" maxlength="100" required></label><button class="secondary-button" type="submit">Request badge review</button></form></article><% } %><article class="surface"><h3>A little room for your ideas</h3><form action="/account/businesses" method="post"><%- include('../partials/csrf') %><label>Business name<input name="name" minlength="2" maxlength="80" required></label><button class="primary-button" type="submit">Link a business ↗</button></form></article></div></section>
