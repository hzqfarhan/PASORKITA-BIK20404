<div class="page-heading"><div class="section-overline"><%= typeof savedPage!=='undefined'?'A LITTLE COLLECTION':'THE CAMPUS EDIT' %></div><h1><%= title %></h1><p><%= typeof savedPage!=='undefined'?'Good things to come back to. Saved to your account.':'A good meal. A fresh start for preloved. A little campus connection.' %></p></div>
<%- include('../partials/categories') %>
<% if(typeof savedPage==='undefined'){ %><form class="catalogue-filters surface" action="/products"><label>Find something<input type="search" name="q" maxlength="100" value="<%= typeof query.q==='string'?query.q:'' %>" placeholder="Search products or sellers"></label><label>Campus<select name="campus"><option value="">All campuses</option><% for(const campus of ['Parit Raja','Pagoh']){ %><option <%= query.campus===campus?'selected':'' %>><%= campus %></option><% } %></select></label><label>Up to RM<input type="number" name="maxPrice" min="1" max="1000000" value="<%= typeof query.maxPrice==='string'?query.maxPrice:'' %>" placeholder="Any price"></label><label>Sort by<select name="sort"><% for(const [value,label] of [['newest','Newest first'],['price-low','Price: low to high'],['price-high','Price: high to low']]){ %><option value="<%= value %>" <%= query.sort===value?'selected':'' %>><%= label %></option><% } %></select></label><% if(query.category){ %><input type="hidden" name="category" value="<%= query.category %>"><% } %><% if(query.business==='1'){ %><input type="hidden" name="business" value="1"><% } %><button class="primary-button" type="submit">Find my thing</button><a href="/products" class="text-button">Clear</a></form><% } %>
<div class="marketplace-toolbar"><span><%= products.length %> finds on this page</span><a href="/seller/products/new" class="outline-button">List something ↗</a></div><%- include('../partials/product-grid') %>
<% if(typeof savedPage==='undefined'){const pageNumber=Number(query.page)||1;const queryParams=new URLSearchParams(Object.entries(query).filter(([k,v])=>typeof v==='string')); %><nav class="pagination" aria-label="Product pages"><% if(pageNumber>1){queryParams.set('page',pageNumber-1); %><a class="secondary-button" href="/products?<%= queryParams.toString() %>">Previous finds</a><% } %><% if(products.length===24){queryParams.set('page',pageNumber+1); %><a class="secondary-button" href="/products?<%= queryParams.toString() %>">More finds ↗</a><% } %></nav><% } %>
