<div class="page-heading"><a class="eyebrow-link" href="/seller">← Your seller studio</a><h1><%= product?'A little refresh':'Make room for something new' %></h1><p>A little detail helps the right campus neighbour find you.</p></div><form class="surface editor-form" action="/seller/products<%= product?'/'+product.id:'' %>" method="post" enctype="multipart/form-data"><%- include('../partials/csrf') %><div class="form-grid"><label class="wide-field">Give it a name<input name="title" minlength="3" maxlength="100" value="<%= product?.title || '' %>" required></label><label>Category<select name="category_id" required><% for(const category of categories){ %><option value="<%= category.id %>" <%= product?.category_id===category.id?'selected':'' %>><%= category.name %></option><% } %></select></label><label>Post as<select name="business_id"><option value="">My personal profile</option><% for(const business of businesses){ %><option value="<%= business.id %>" <%= product?.business_id===business.id?'selected':'' %>><%= business.name %></option><% } %></select></label><label>Price (RM)<input name="price" type="number" min="0.01" max="999999.99" step="0.01" value="<%= product?.price || '' %>" required></label><label>Stock available<input name="stock" type="number" min="0" max="100000" value="<%= product?.stock ?? 1 %>" required></label><label>Campus<select name="campus"><% for(const campus of ['Parit Raja','Pagoh']){ %><option <%= (product?.campus || user.campus)===campus?'selected':'' %>><%= campus %></option><% } %></select></label><label>Condition<input name="item_condition" minlength="2" maxlength="60" placeholder="Like new, freshly made…" value="<%= product?.item_condition || '' %>" required></label><label class="wide-field">Pickup location<input name="pickup_location" minlength="3" maxlength="160" value="<%= product?.pickup_location || '' %>" placeholder="A clear public meeting point on campus" required></label><label class="wide-field">A little more about it<textarea name="description" minlength="12" maxlength="4000" rows="5" required><%= product?.description || '' %></textarea></label><label>Upload a product photo<input name="image" type="file" accept="image/jpeg,image/png,image/webp"><small class="field-help">JPEG, PNG or WebP. Up to 4 MB.</small></label><label>Or choose a sample image<select name="image_choice"><option value="">Keep current / default image</option><% for(const image of ['nasi','headphones','matcha','camera','design','calculator','sneakers','books']){ %><option><%= image %></option><% } %></select></label></div><div class="action-row"><button type="submit" class="primary-button"><%= product?'Save changes':'Publish my listing' %> ↗</button><a href="/seller" class="secondary-button">Back to studio</a></div></form>
