HOST=127.0.0.1
PORT=4173
NODE_ENV=development
# Set to 1 only behind one trusted HTTPS reverse proxy on your hosting service.
TRUST_PROXY=0
# Supabase dashboard > Connect > Session pooler > PostgreSQL connection string.
# URL-encode special characters in the database password. Keep this server-only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Optional Supabase CA certificate path if your connection requires its CA.
# DATABASE_CA_CERT=.local/prod-ca-2021.crt
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Only used by the explicit database setup command, never by registration.
SEED_PASSWORD=replace-with-a-strong-demo-password
SEED_ADMIN_EMAIL=admin@uthm.edu.my
