m\" data-action=\"nav-saved\"><svg><use href=\"#i-heart\"/></svg>Saved finds<span class=\"nav-count\" id=\"saved-count\">0</span></button>\n      <button class=\"nav-item\" data-action=\"nav-messages\"><svg><use href=\"#i-chat\"/></svg>Messages</button>\n      <button class=\"nav-item\" data-action=\"nav-my-listings\"><svg><use href=\"#i-bag\"/></svg>My listings</button>\n      <button class=\"nav-item account-nav-item\" data-action=\"nav-account\"><svg><use href=\"#i-shield\"/></svg>My account<span class=\"nav-count\" id=\"linked-business-count\">0</span></button>\n    </nav>\n\n    <div class=\"sidebar-card-section\">\n      <div class=\"sidebar-label\">A LITTLE MORE YOU <svg><use href=\"#i-spark\"/></svg></div>\n      <button class=\"mini-card-scene\" data-action=\"profile\" aria-label=\"Explore your interactive 3D campus card\">\n        <span class=\"mini-campus-card\"><span class=\"mini-card-top\"><span>pasor.</span><svg><use href=\"#i-spark\"/></svg></span><span class=\"mini-card-orbit\"></span><span class=\"mini-avatar\" id=\"mini-card-avatar\">a.</span><span class=\"mini-card-name\" id=\"mini-card-name\">Your campus identity</span><span class=\"mini-card-role\" id=\"mini-card-role\">PERSONAL + BUSINESS</span><span class=\"mini-card-bottom\">UTHM COMMUNITY <svg><use href=\"#i-check\"/></svg></span></span>\n        <span class=\"mini-card-caption\">Your campus. Your identity.<svg><use href=\"#i-up-right\"/></svg></span>\n      </button>\n      <p class=\"sample-label\">One university login. All your identities.</p>\n    </div>\n\n    <div class=\"business-invite\"><svg class=\"business-invite-icon\"><use href=\"#i-spark\"/></svg><h3>Your business.<br>Your next chapter.</h3><p>SSM or PTU registered?<br>Link it to your campus account.</p><div class=\"sidebar-badge-pair\"><span class=\"verification-badge badge-ssm\">SSM</span><span class=\"verification-badge badge-ptu\">PTU</span></div><button data-action=\"perks\">Explore business badges <svg><use href=\"#i-arrow\"/></svg></button></div>\n    <div class=\"sidebar-bottom\"><button class=\"help-button\" data-action=\"how-it-works\"><svg><use href=\"#i-help\"/></svg>How PASOR works<svg class=\"help-arrow\"><use href=\"#i-up-right\"/></svg></button><div class=\"sidebar-footer\"><span class=\"green-dot\"></span> A little closer. A little more local.</div></div>\n  </aside>\n\n  <div class=\"app-shell\">\n    <header class=\"topbar\">\n      <button class=\"icon-button mobile-menu\" data-action=\"toggle-mobile-nav\" aria-label=\"Open navigation\" aria-expanded=\"false\"><svg><use href=\"#i-menu\"/></svg></button>\n      <div class=\"header-greeting\">Good finds start here<span>Made for the UTHM community.</span></div>\n      <label class=\"global-search\"><svg><use href=\"#i-search\"/></svg><input id=\"search-input\" type=\"search\" placeholder=\"What are you looking for?\" aria-label=\"Search marketplace\"><kbd>/</kbd></label>\n      <div class=\"topbar-actions\"><button class=\"icon-button notification-button\" data-action=\"notifications\" aria-label=\"View campus updates\"><svg><use href=\"#i-bell\"/></svg><span></span></button><span class=\"topbar-divider\"></span><button class=\"login-button account-header-button\" data-action=\"account\"><span class=\"account-button-text\"><span id=\"account-label\">Sign in with UTHM</span><small id=\"account-role-label\">Students & staff</small></span><svg><use href=\"#i-up-right\"/></svg></button></div>\n    </header>\n\n    <main id=\"main-content\">\n      <div class=\"page-intro\"><span><span class=\"live-dot\"></span> A MARKETPLACE THAT FEELS LIKE CAMPUS</span><label class=\"campus-picker\"><svg><use href=\"#i-pin\"/></svg><select id=\"campus-select\" aria-label=\"Filter by campus\"><option value=\"All campuses\">All UTHM campuses</option><option value=\"Parit Raja\">Parit Raja</option><option value=\"Pagoh\">Pagoh</option></select><svg class=\"campus-chevron\"><use href=\"#i-chevron\"/></svg></label></div>\n\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div class=\"hero-copy\"><div class=\"hero-eyebrow\"><span>LOCAL FINDS. CAMPUS CONNECTIONS.</span><svg class=\"small-star\"><use href=\"#i-spark\"/></svg></div><h1 id=\"hero-title\">Big finds.<br><span>Small campus.</span></h1><p>Your next favourite meal. A fresh start for preloved.<br>A little help from someone down the hall.</p><div class=\"hero-buttons\"><a class=\"primary-button\" href=\"#marketplace\">Find your thing<svg><use href=\"#i-arrow\"/></svg></a><button class=\"hero-sell\" data-action=\"sell\">Start selling<svg><use href=\"#i-up-right\"/></svg></button></div><div class=\"hero-community\"><div class=\"avatar-stack\"><span>N</span><span>A</span><span>S</span><span>H</span></div><span>One campus community.<br><strong>Endless possibilities.</strong></span></div></div>\n        <div class=\"hero-art\"><div class=\"hero-orbit orbit-one\"></div><div class=\"hero-orbit orbit-two\"></div><div class=\"hero-dots\"></div><img class=\"hero-scene\" src=\"/assets/hero-scene.svg\" alt=\"Sculptural burgundy PASOR shopping bag with floating objects on a cream pedestal\"><span class=\"hero-handwritten\">good things<br>are closer.<svg viewBox=\"0 0 40 30\"><path d=\"M5 4c22-9 36 11 19 20m-2-8 2 8 9-2\"/></svg></span><svg class=\"hero-spark spark-one\"><use href=\"/assets/lowpoly-icons.svg#spark\"/></svg><svg class=\"hero-spark spark-two\"><use href=\"/assets/lowpoly-icons.svg#spark\"/></svg><div class=\"floating-note\"><span class=\"floating-check\"><svg><use href=\"#i-shield\"/></svg></span><span>Our campus. Our people.<small>A community built on connection.</small></span></div></div>\n        <div class=\"hero-corner\">A LITTLE LOCAL GOES A LONG WAY <svg><use href=\"#i-up-right\"/></svg></div>\n      </section>\n\n      <section class=\"categories\" aria-label=\"Browse by category\">\n        <button class=\"category-card active\" data-category=\"All\" aria-pressed=\"true\"><span class=\"category-art\"><svg><use href=\"/assets/lowpoly-icons.svg#all\"/></svg></span><span>All finds<small>A bit of everything</small></span><svg><use href=\"#i-up-right\"/></svg></button>\n        <button class=\"category-card\" data-category=\"Food\" aria-pressed=\"false\"><span class=\"category-art\"><svg><use href=\"/assets/lowpoly-icons.svg#food\"/></svg></span><span>Food & drinks<small>Good mood food</small></span></button>\n        <button class=\"category-card\" data-category=\"Preloved\" aria-pressed=\"false\"><span class=\"category-art\"><svg><use href=\"/assets/lowpoly-icons.svg#preloved\"/></svg></span><span>Preloved<small>New to you</small></span></button>\n        <button class=\"category-card\" data-category=\"Services\" aria-pressed=\"false\"><span class=\"category-art\"><svg><use href=\"/assets/lowpoly-icons.svg#services\"/></svg></span><span>Services<small>A helping hand</small></span></button>\n        <button class=\"category-card\" data-category=\"Rentals\" aria-pressed=\"false\"><span class=\"category-art\"><svg><use href=\"/assets/lowpoly-icons.svg#rentals\"/></svg></span><span>Rentals<small>Borrow the good stuff</small></span></button>\n        <button class=\"category-card\" data-category=\"Others\" aria-pressed=\"false\"><span class=\"category-art\"><svg><use href=\"/assets/lowpoly-icons.svg#others\"/></svg></span><span>Others<small>Something unexpected</small></span></button>\n      </section>\n\n      <section class=\"marketplace-section\" id=\"marketplace\" aria-labelledby=\"section-title\">\n        <div class=\"section-heading\"><div><div class=\"section-overline\">THE CAMPUS EDIT</div><h2 id=\"section-title\">Fresh finds, just for you<svg class=\"heading-spark\"><use href=\"#i-spark\"/></svg></h2><p id=\"section-description\">A little of what’s happening around you.</p></div><button class=\"outline-button sell-button\" data-action=\"sell\"><svg><use href=\"#i-plus\"/></svg>List something</button></div>\n        <div class=\"posting-identity-bar\"><button class=\"posting-identity-button\" data-action=\"switch-identity\"><span class=\"posting-identity-icon\"><svg><use href=\"#i-shield\"/></svg></span><span><small>POST AS</small><strong id=\"identity-label\">Your campus account</strong></span><svg class=\"posting-identity-chevron\"><use href=\"#i-chevron\"/></svg></button><span class=\"identity-bar-description\">One university account. A place for every side of you.</span><button class=\"identity-manage-button\" data-action=\"manage-businesses\">Link a business<svg><use href=\"#i-plus\"/></svg></button></div>\n        <div class=\"marketplace-toolbar\"><div class=\"filter-summary\"><span id=\"active-filter-label\">All finds</span><span class=\"toolbar-dot\">·</span><span id=\"result-count\" aria-live=\"polite\">8 listings</span><span class=\"sample-inventory\">SAMPLE CAMPUS EDIT</span></div><div class=\"sort-controls\"><button class=\"filter-button\" data-action=\"filters\"><svg><use href=\"#i-sliders\"/></svg>Filters</button><label class=\"sort-label\">Sort by:<select id=\"sort-select\" aria-label=\"Sort listings\"><option value=\"recommended\">Recommended</option><option value=\"newest\">Newest first</option><option value=\"price-low\">Price: low to high</option><option value=\"price-high\">Price: high to low</option></select><svg><use href=\"#i-chevron\"/></svg></label></div></div>\n        <div class=\"product-grid\" id=\"product-grid\" aria-live=\"polite\"></div>\n      </section>\n\n      <section class=\"top-selling-section\" aria-labelledby=\"top-selling-title\"><div class=\"section-heading\"><div><div class=\"section-overline\">THE CAMPUS CHARTS</div><h2 id=\"top-selling-title\">Good things get around.<svg class=\"heading-spark\"><use href=\"#i-spark\"/></svg></h2><p id=\"top-selling-description\">Top-selling finds · sample campus sales.</p></div><label class=\"top-selling-period\">Top sellers<select id=\"top-selling-period\" aria-label=\"Top selling period\"><option value=\"week\">This week</option><option value=\"month\">This month</option></select><svg><use href=\"#i-chevron\"/></svg></label></div><div id=\"top-selling-grid\" class=\"top-selling-grid\"></div></section>\n      <section class=\"community-strip\"><div class=\"community-strip-art\"><svg><use href=\"#i-spark\"/></svg><span>p.</span><svg><use href=\"#i-spark\"/></svg></div><div><span class=\"section-overline\">YOUR NEXT CHAPTER STARTS HERE</span><h2>Your ideas. Your businesses. One account.</h2><p>Connect your business and build your presence with separate SSM and PTU badges.</p></div><button class=\"primary-button\" data-action=\"perks\">Meet the badges<svg><use href=\"#i-up-right\"/></svg></button></section>\n      <footer class=\"main-footer\"><span><strong>pasor.</strong> Made for the people who make UTHM.</span><span>Interactive preview <span>·</span> Sample listings <span>·</span> Campus sign-in coming next</span><button data-action=\"how-it-works\">Community guide<svg><use href=\"#i-up-right\"/></svg></button></footer>\n    </main>\n  </div>\n  <div id=\"modal-root\"></div><div id=\"toast-root\" role=\"status\" aria-live=\"polite\"></div><div id=\"validation-root\"></div>",
