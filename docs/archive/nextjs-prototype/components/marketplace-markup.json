{
  "html": "<div class=\"campus-atmosphere\" aria-hidden=\"true\"><span class=\"atmosphere-glow glow-burgundy\"></span><span class=\"atmosphere-glow glow-gold\"></span><span class=\"atmosphere-grid\"></span><img class=\"atmosphere-orbit\" src=\"/assets/campus-orbit.svg\" alt=\"\"><span class=\"atmosphere-poly poly-one\"></span><span class=\"atmosphere-poly poly-two\"></span><span class=\"atmosphere-poly poly-three\"></span></div>\n  <a class=\"skip-link\" href=\"#marketplace\">Skip to marketplace</a>\n  <svg class=\"icon-sprite\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><defs>\n    <symbol id=\"i-grid\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/></symbol>\n    <symbol id=\"i-store\" viewBox=\"0 0 24 24\"><path d=\"M3 10l2-6h14l2 6M4 11v9h16v-9M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0M9 20v-6h6v6M9 4v6M15 4v6\"/></symbol>\n    <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z\"/></symbol>\n    <symbol id=\"i-chat\" viewBox=\"0 0 24 24\"><path d=\"M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-1 1v-9.5A8.5 8.5 0 0 1 11.5 3h1a8.5 8.5 0 0 1 8.5 8.5Z\"/><path d=\"M8 9h8M8 13h5\"/></symbol>\n    <symbol id=\"i-bag\" viewBox=\"0 0 24 24\"><path d=\"M5 7h14l2 14H3L5 7Z\"/><path d=\"M8 8V6a4 4 0 0 1 8 0v2\"/></symbol>\n    <symbol id=\"i-arrow\" viewBox=\"0 0 24 24\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></symbol>\n    <symbol id=\"i-up-right\" viewBox=\"0 0 24 24\"><path d=\"M6 18 18 6M6 6h12v12\"/></symbol>\n    <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></symbol>\n    <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z\"/><circle cx=\"12